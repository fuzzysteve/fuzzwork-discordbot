[Unit]
Description=Daily dependency update check for the Fuzzwork Discord bot

[Timer]
# Calendar-based (host local time, Europe/Berlin), not OnBootSec/OnUnitActiveSec — see
# the timer gotcha in CLAUDE.md. A read-only check, so a catch-up run after downtime
# (Persistent=true) is harmless.
OnCalendar=*-*-* 09:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
