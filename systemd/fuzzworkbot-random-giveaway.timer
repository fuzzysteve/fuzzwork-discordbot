[Unit]
Description=Periodically create a random Fuzzwork giveaway

[Timer]
# Hourly check, not a fixed 48h interval: the service runs `giveaway random
# --only-if-idle`, which creates nothing while the channel still has a pending or
# active giveaway. So a new giveaway starts within an hour of the previous one ending,
# whatever its duration.
#
# This replaced OnUnitActiveSec=48h, which counts from the service's last activation
# *in the current boot*: after a reboot (2026-11-18) the service had never run, so the
# timer had no reference point and never fired again (NextElapse=infinity). Persistent=
# only catches up OnCalendar= runs, not OnUnitActiveSec=, so it didn't help.
#
# Persistent=true with OnCalendar= is safe here (unlike the old OnBootSec= setup, which
# fired an unplanned giveaway on enable): a catch-up run after boot or on enable just
# hits the idle check, so it can only ever start a giveaway when none is running.
OnCalendar=hourly
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
