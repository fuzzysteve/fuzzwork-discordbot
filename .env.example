# Discord bot token from the Discord Developer Portal (rotate the old exposed one before use).
DISCORD_BOT_TOKEN=<your-discord-bot-token>

# Single guild this bot operates in.
GUILD_ID=<your-guild-id>

# Role granted on successful EVE verification (/authme). Use the role ID, not its name.
VALIDATED_ROLE_ID=<your-role-id>

# SQLAlchemy connection string. Rotate the MySQL password before use.
DATABASE_URL=mysql+pymysql://discordbot:<your-password>@localhost/discordbot

# Sent as the User-Agent on ESI requests per CCP's third-party dev guidelines.
ESI_USER_AGENT=fuzzworkbot (contact: <your-contact-email>)
